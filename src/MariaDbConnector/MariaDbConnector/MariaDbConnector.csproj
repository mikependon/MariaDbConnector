<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>MariaDbConnector</Title>
    <AssemblyName>MariaDbConnector</AssemblyName>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>A .NET-based connector for MariaDB. (This is not the official MariaDB package)</Description>
    <Authors>mike_pendon</Authors>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <PackageTags>mariadb ado.net data provider database</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/mikependon/MariaDbConnector</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mikependon/MariaDbConnector</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="26.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
